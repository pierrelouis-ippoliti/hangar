# Copy this file to .env and fill in the values. .env is never committed.
# These settings say where things run; they don't change the results.

# Mistral API key, used by `hangar ask` and the seed run.
MISTRAL_API_KEY=

# Folder for downloaded documents and pipeline outputs.
HANGAR_DATA_DIR=

# Qdrant server URL, for example http://127.0.0.1:6333.
HANGAR_QDRANT_URL=

# Hugging Face cache folder for model weights. Leave empty for the default.
HF_HOME=

# Device for the embedding model: cpu, cuda or mps.
HANGAR_DEVICE=

# Log level: DEBUG, INFO, WARNING or ERROR.
HANGAR_LOG_LEVEL=
